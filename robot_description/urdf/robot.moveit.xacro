<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="crx10ia_l">
    
    <!-- Robot model -->
    <xacro:include filename="$(find robot_description)/urdf/robot.xacro"/>

    <!-- MoveIt ROS2 control -->
    <xacro:include filename="$(find robot_description)/urdf/moveit.ros2_control.xacro" />    
    <xacro:moveit_ros2_control 
        initial_positions_file="$(find robot_moveit_config)/config/initial_positions.yaml"
    />
</robot>
