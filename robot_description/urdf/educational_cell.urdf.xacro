<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="educational_cell">

    <!-- Properties -->
    <xacro:property name="table_length" value="1.2"/>
    <xacro:property name="table_width" value="0.8"/>
    <xacro:property name="table_height" value="0.69"/>
    <xacro:property name="bracket_thickness" value="0.005"/>
    <xacro:property name="wheel_radius" value="0.045"/>
    <xacro:property name="wheel_width" value="0.02"/>
    <xacro:property name="wheel_offset_side" value="0.01"/>
    <xacro:property name="wheel_offset_end" value="0.05"/>
    <xacro:property name="foot_offset_end" value="0.15"/>
    <xacro:property name="foot_size" value="0.04"/>
    <xacro:property name="table_elevation" value="0.1"/>

    <!-- Main table body -->
    <link name="table">
        <visual>
            <geometry>
                <box size="${table_length} ${table_width} ${table_height}"/>
            </geometry>
            <origin xyz="0 0 ${table_elevation + table_height / 2}" rpy="0 0 0"/>
            <material name="FANUC_White"/>
        </visual>
        <collision>
            <geometry>
                <box size="${table_length} ${table_width} ${table_height}"/>
            </geometry>
            <origin xyz="0 0 ${table_elevation + table_height / 2}" rpy="0 0 0"/>
        </collision>
        <inertial>
            <mass value="10.0"/>
            <origin xyz="0 0 ${table_elevation + table_height / 2}" rpy="0 0 0"/>
            <inertia ixx="1" iyy="1" izz="1" ixy="0" ixz="0" iyz="0"/>
        </inertial>
    </link>

    <link name="world"/>
    <joint name="table_base_joint" type="fixed">
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <parent link="world"/>
        <child link="table" />
      </joint>    

    <!-- Reusable wheel+bracket macro -->
    <xacro:macro name="wheel" params="prefix x y">

        <!-- Bracket -->
        <link name="${prefix}_bracket">
            <visual>
                <geometry>
                    <box size="0.05 0.05 ${table_elevation - wheel_radius}"/>
                </geometry>
                <origin xyz="${x} ${y} ${(table_elevation + wheel_radius)/2}" rpy="0 0 0"/>
                <material name="FANUC_White"/>
            </visual>
            <collision>
                <geometry>
                    <box size="0.05 0.05 ${table_elevation - wheel_radius}"/>
                </geometry>
                <origin xyz="${x} ${y} ${(table_elevation + wheel_radius)/2}" rpy="0 0 0"/>
            </collision>
            <inertial>
                <mass value="0.2"/>
                <origin xyz="${x} ${y} ${(table_elevation + wheel_radius)/2}" rpy="0 0 0"/>
                <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0"/>
            </inertial>
        </link>

        <joint name="${prefix}_bracket_joint" type="fixed">
            <parent link="table"/>
            <child link="${prefix}_bracket"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </joint>

        <!-- Wheel -->
        <link name="${prefix}_wheel">
            <visual>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
                </geometry>
                <origin xyz="${x} ${y} ${wheel_radius}" rpy="1.5708 0 0"/>
                <material name="FANUC_Black"/>
            </visual>
            <collision>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
                </geometry>
            <origin xyz="${x} ${y} ${wheel_radius}" rpy="1.5708 0 0"/>
            </collision>
            <inertial>
                <mass value="0.5"/>
                <origin xyz="${x} ${y} ${wheel_radius}" rpy="0 0 0"/>
                <inertia ixx="0.01" iyy="0.01" izz="0.01" ixy="0" ixz="0" iyz="0"/>
            </inertial>
        </link>

        <joint name="${prefix}_joint" type="fixed">
            <parent link="${prefix}_bracket"/>
            <child link="${prefix}_wheel"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </joint>
    </xacro:macro>

    <!-- Reusable foot macro -->
    <xacro:macro name="foot" params="prefix x y">
        <link name="${prefix}_foot">
            <visual>
                <geometry>
                    <box size="${foot_size} ${foot_size} 0.08"/>
                </geometry>
                <origin xyz="${x} ${y} 0.06" rpy="0 0 0"/>
                <material name="FANUC_White"/>
            </visual>
            <collision>
                <geometry>
                    <box size="${foot_size} ${foot_size} 0.08"/>
                </geometry>
            <origin xyz="${x} ${y} 0.06" rpy="0 0 0"/>
            </collision>
            <inertial>
                <mass value="0.1"/>
                <origin xyz="${x} ${y} 0.06" rpy="0 0 0"/>
                <inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0" ixz="0" iyz="0"/>
            </inertial>
        </link>
    </xacro:macro>

    <!-- Wheels with brackets -->
    <xacro:wheel prefix="front_left" x="${table_length/2 - wheel_offset_end}" y="${table_width/2 - wheel_width/2}"/>
    <xacro:wheel prefix="rear_left" x="${-table_length/2 + wheel_offset_end}" y="${table_width/2 - wheel_width/2}"/>
    <xacro:wheel prefix="front_right" x="${table_length/2 - wheel_offset_end}" y="${-table_width/2 + wheel_width/2}"/>
    <xacro:wheel prefix="rear_right" x="${-table_length/2 + wheel_offset_end}" y="${-table_width/2 + wheel_width/2}"/>

    <!-- Feet -->
    <xacro:foot prefix="front_left" x="${table_length/2 - foot_offset_end}" y="${table_width/2 - foot_size/2}"/>
    <joint name="foot_front_left_joint" type="fixed">
        <parent link="table"/>
        <child link="front_left_foot"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <xacro:foot prefix="rear_left" x="${-table_length/2 + foot_offset_end}" y="${table_width/2 - foot_size/2}"/>
    <joint name="foot_rear_left_joint" type="fixed">
        <parent link="table"/>
        <child link="rear_left_foot"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <xacro:foot prefix="front_right" x="${table_length/2 - foot_offset_end}" y="${-table_width/2 + foot_size/2}"/>
    <joint name="foot_front_right_joint" type="fixed">
        <parent link="table"/>
        <child link="front_right_foot"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <xacro:foot prefix="rear_right" x="${-table_length/2 + foot_offset_end}" y="${-table_width/2 + foot_size/2}"/>
    <joint name="foot_rear_right_joint" type="fixed">
        <parent link="table"/>
        <child link="rear_right_foot"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>
</robot>